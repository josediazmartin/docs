{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Asentado",
  "description": "Centro de ayuda de Asentado para consultoras de Higiene y Seguridad: guías paso a paso para el panel web y la app del prevencionista.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/favicon.ico"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Inicio",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Ir a Asentado",
          "icon": "external-link",
          "href": "https://app.asentado.io"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Empezar",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "index",
          "empezar/dos-paneles",
          "empezar/glosario"
        ]
      },
      {
        "group": "Panel de la consultora",
        "icon": "building-2",
        "expanded": true,
        "pages": [
          "consultora/iniciar-sesion",
          "consultora/oficinas",
          "consultora/prevencionistas",
          "consultora/maquinaria",
          "consultora/planificacion",
          "consultora/formularios",
          "consultora/miembros-y-configuracion"
        ]
      },
      {
        "group": "Panel del cliente",
        "icon": "briefcase",
        "expanded": true,
        "pages": [
          "cliente/vincular",
          "cliente/obras",
          "cliente/ticketera",
          "cliente/reportes",
          "cliente/hallazgos",
          "cliente/cuasi-accidentes",
          "cliente/documentacion",
          "cliente/notificaciones",
          "cliente/capacitaciones"
        ]
      },
      {
        "group": "App del prevencionista",
        "icon": "smartphone",
        "expanded": true,
        "pages": [
          "app/primeros-pasos",
          "app/visitas-y-formularios",
          "app/hallazgos",
          "app/tickets",
          "app/offline"
        ]
      },
      {
        "group": "Ayuda",
        "icon": "circle-help",
        "expanded": true,
        "pages": [
          "preguntas-frecuentes"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png",
    "href": "https://asentado.io/"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Ir a Asentado",
      "href": "https://app.asentado.io"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Asentado",
        "items": [
          {
            "label": "Ir a la app",
            "href": "https://app.asentado.io"
          }
        ]
      }
    ]
  }
}
